rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to check if a user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if the user is the Super Admin
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'ahmad.andryanto50@admin.smp.belajar.id';
    }

    // Helper to check if incoming data conforms to user schema
    function isValidUserLog(data) {
      return data.name is string && data.name.size() <= 200
        && data.status is string && (data.status == 'allowed' || data.status == 'rejected' || data.status == 'pending')
        && data.firstLogin is string;
    }

    match /users/{email} {
      // Any signed in user can read their own status, and the Super Admin can read all
      allow get: if isSignedIn() && (request.auth.token.email == email || isSuperAdmin());
      
      // Super Admin can list all users
      allow list: if isSuperAdmin();

      // Any signed in user can register their own status (create) with 'pending' status
      allow create: if isSignedIn() 
        && request.auth.token.email == email 
        && isValidUserLog(request.resource.data)
        && (request.resource.data.status == 'pending' || request.auth.token.email == 'ahmad.andryanto50@admin.smp.belajar.id');

      // Users can update their own lastLogin (if status is unchanged), and Super Admin can update any field
      allow update: if isSignedIn() && (
        isSuperAdmin() && isValidUserLog(request.resource.data)
        || (
          request.auth.token.email == email 
          && isValidUserLog(request.resource.data)
          && request.resource.data.status == resource.data.status
        )
      );

      // Super Admin can delete users
      allow delete: if isSuperAdmin();
    }
  }
}
